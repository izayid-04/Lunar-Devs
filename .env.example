# Copy this file to .env.local for local development.
# In production (Hodifly), these are set in the cPanel/Hodifly app config,
# not in a committed .env file — see docs/DEPLOIEMENT.md.

# Base URL of the NestJS API (no trailing slash). Exposed to the browser,
# so it must never contain secrets.
NEXT_PUBLIC_API_URL=https://api.lunardevs.lescomores.webcup.hodi.cloud

# Only needed for local testing of the production server (server.cjs).
# On Hodifly, PORT is injected automatically by Passenger — do not set it there.
PORT=3000
